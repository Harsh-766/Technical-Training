class Solution {
public:
    bool sumGame(string num) {
        int n = num.size();
        int leftq = 0;
        int rightq = 0;
        int leftSum = 0;
        int rightSum = 0;
        for(int i = 0; i<n/2; i++){
            if(num[i] == '?'){
                leftq++;
            } else{
                leftSum += num[i]-'0';
            }
        }
        for(int i = n/2; i<n; i++){
            if(num[i] == '?'){
                rightq++;
            } else {
                rightSum += num[i] - '0';
            }
        }
          if ((leftq + rightq) % 2 == 1) {
            return true;
        }
        int sumDiff = leftSum - rightSum;
        
        return sumDiff != 9 * (rightq - leftq) / 2;
    }
};
