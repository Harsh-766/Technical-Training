class Solution {
public:
    bool detectCapitalUse(string word) {
      bool allUpper = true;
      bool allLower = true;
      for(char c : word){
        if(c >= 'a' && c <= 'z'){
            allUpper =  false;
        }
        if(c >= 'A' && c <= 'Z'){
            allLower= false;
        }
      }
      if(allUpper || allLower){
        return true;
      }
      if(word[0] >= 'A' && word[0] <= 'Z'){
        for(int i = 1; i<word.size(); i++){
            if(word[i] >= 'A' && word[i] <= 'Z'){
                return false;
            }
        }
        return true;
      }
      return false;
    }
};
