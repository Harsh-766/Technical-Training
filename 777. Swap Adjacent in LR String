class Solution {
public:
    bool canTransform(string start, string result) {
        int i = 0;
        int j = 0;
        int n = start.size();
        int m = result.size();
        while(i < n || j < m){
            while(i < n && start[i] == 'X') i++;
            while(j < m && result[j] == 'X') j++;

            if(start[i] != result[j]){
                return false;
            }
            if(start[i] == 'L' && i<j){
                return false;
            }
            if(start[i] == 'R' && i > j){
                return false;
            }
            i++;
            j++;
        }
    return true;
    }
};
