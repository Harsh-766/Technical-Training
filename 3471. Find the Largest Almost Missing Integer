class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {

        int ans = -1;
        unordered_map<int, int> windowCount;

        for (int i = 0; i <= nums.size() - k; i++) {

            unordered_set<int> seen;

            for (int j = i; j < i + k; j++) {
                seen.insert(nums[j]);
            }

            for (int num : seen) {
                windowCount[num]++;
            }
        }

        for (auto& [num, count] : windowCount) {
            if (count == 1) {
                ans = max(ans, num);
            }
        }

        return ans;
    }
};
