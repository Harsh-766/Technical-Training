class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        unordered_map<int,int> rows;
        for(auto& seat : reservedSeats){
            int row = seat[0];
            int col = seat[1];
            rows[row] |= (1 << (col-1));
        }
        int ans = (n-rows.size()) * 2;
        for(auto& [row,reserved] : rows){
            bool left = (reserved & 0b0111100000) == 0;
            bool middle = (reserved & 0b0001111000) == 0;
            bool right = (reserved & 0b0000011110) == 0;
            if(left && right){
                ans += 2;
            }
            else if (left || middle || right){
                ans += 1;

            }
        }
        return ans;
    }
};
