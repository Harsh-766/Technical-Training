class Solution {
public:
    int n;
    unordered_set<string> st;
    int maxLen;

    void solve(string& s, int i, string& curr, int count) {

        if(count < 0)
            return;

        if(i == n) {
            if(count == 0) {
                if(curr.size() > maxLen) {
                    maxLen = curr.size();
                    st.clear();
                }

                if(curr.size() == maxLen) {
                    st.insert(curr);
                }
            }
            return;
        }

        if(s[i] != ')' && s[i] != '(') {
            curr.push_back(s[i]);
            solve(s, i + 1, curr, count);
            curr.pop_back();
            return;
        }

        // Keep the parenthesis
        curr.push_back(s[i]);

        int newCount = count + (s[i] == '(' ? 1 : -1);

        solve(s, i + 1, curr, newCount);

        curr.pop_back();

        // Remove the parenthesis
        solve(s, i + 1, curr, count);
    }

    vector<string> removeInvalidParentheses(string s) {
        n = s.size();
        st.clear();
        maxLen = 0;

        string curr = "";
        solve(s, 0, curr, 0);

        return vector<string>(st.begin(), st.end());
    }
};
