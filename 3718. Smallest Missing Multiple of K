class Solution {
public:
    int missingMultiple(vector<int>& nums, int k) {
        unordered_set<int> s;
        for(int x : nums){
            s.insert(x);
        }
        for(int i = 1; ; i++){
            int multiple = k * i;
            if(s.count(multiple) == 0){
                return multiple;
            }
        }
    }
};
