class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        unordered_set<int> st;
        for(int num : nums){
            st.insert(num);
        }
        int longest = 0;
        for(int num : st){
            if(st.count(num-1) == 0){
                int curr = num;
                int len = 0;
            while(st.count(curr)){
                
                len++;
                curr++;
            }
            longest = max(longest,len);
            }
        }
        return longest;
        
    }
};
