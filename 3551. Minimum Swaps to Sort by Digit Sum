class Solution {
public:
    int digitSum(int x){
        int sum = 0;
        while(x > 0){
            sum += x % 10;
            x /= 10;
        }
        return sum;     
    }
    int minSwaps(vector<int>& nums) {
        int n = nums.size();

        vector<int> afterSorted(nums);
        auto lambda = [&](int num1, int num2){
            int num1DigitSum = digitSum(num1);
            int num2DigitSum = digitSum(num2);

            if(num1DigitSum != num2DigitSum){
                return num1DigitSum < num2DigitSum;
            }
            return num1 < num2;
        };
        sort(begin(afterSorted), end(afterSorted), lambda);
        unordered_map<int,int> mp;
        for(int i = 0; i<n; i++){
            mp[nums[i]] = i;
        }
        int swapCount = 0;
        for(int i = 0; i<n; i++){
            int expectedVal = afterSorted[i];
            int currVal = nums[i];
            if(expectedVal == currVal){
                continue;
            }
            int idx = mp[expectedVal];

            nums[i] = expectedVal;
            nums[idx] = currVal;

            mp[expectedVal] = i;
            mp[currVal] = idx;
            swapCount++;
        }
        return swapCount;
    }
};
